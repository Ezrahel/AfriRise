# AfriRise configuration template
# Copy to .env for local Supabase Function work, or set these in Supabase Edge Function secrets.
# Do not commit .env. Do not put SUPABASE_SERVICE_ROLE_KEY or Bachs secrets in dist/config.js.

# Public site URL. Must exactly match the origin that calls the Edge Function (no trailing slash).
SITE_ORIGIN=http://localhost:5173
# Optional second allowed origin for local dashboard testing while SITE_ORIGIN stays deployed.
LOCAL_SITE_ORIGIN=

# Supabase project values: Dashboard → Project Settings → API.
# SUPABASE_URL and SUPABASE_ANON_KEY are provided automatically in deployed Edge Functions,
# but include them when running the function locally.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional deployment/CLI values. They are not read by the application at runtime.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_PERSONAL_ACCESS_TOKEN

# Bachs test/live payment configuration.
BACHS_MODE=sandbox
BACHS_API_KEY=YOUR_BACHS_API_KEY
BACHS_WEBHOOK_SECRET=YOUR_BACHS_WEBHOOK_SECRET
BACHS_ORGANIZATION_ID=YOUR_BACHS_ORGANIZATION_ID
# Required only when monthly giving is enabled.
BACHS_MONTHLY_PRODUCT_ID=

# Keep both false until Bachs has approved the account and sandbox verification is complete.
BACHS_APPROVED=false
PAYMENTS_ENABLED=false

# Browser configuration (public values only). Copy these into dist/config.js before publishing.
# AFRIRISE_API_BASE=https://YOUR_PROJECT_REF.supabase.co/functions/v1/afririse-api
# AFRIRISE_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# AFRIRISE_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
